# .env
SECRET_KEY=your-very-secure-secret-key-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,admin-backend,your-domain.com
DEBUG=0

# Database
POSTGRES_DB=admin_service
POSTGRES_USER=admin
