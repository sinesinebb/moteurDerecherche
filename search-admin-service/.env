# Services externes
SEARCH_SERVICE_URL=http://search-service:8002
CRAWLER_SERVICE_URL=http://crawler-service:8003
INDEXING_SERVICE_URL=http://indexing-service:8004
USER_SERVICE_URL=http://user-service:8001