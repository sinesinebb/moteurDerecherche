# .env
# Environment
ENVIRONMENT=development
DEBUG=false

# Service URLs
USER_SERVICE_URL=http://user-service:8000
INDEXING_SERVICE_URL=http://indexing-service:8001
PAGERANK_SERVICE_URL=http://pagerank-service:8002
CHATBOT_SERVICE_URL=http://chatbot-service:8003
ADMIN_SERVICE_URL=http://admin-service:8004

# Database & Cache
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
REDIS_URL=redis://redis:6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SEARCH_TOPIC=search-events
KAFKA_CRAWLER_TOPIC=crawled-data
KAFKA_INDEXING_TOPIC=indexing-tasks
KAFKA_ANALYTICS_TOPIC=search-analytics
KAFKA_USER_ACTIONS_TOPIC=user-actions

# Security
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256

# Performance
SEARCH_TIMEOUT=10
MAX_RESULTS_PER_PAGE=50
CACHE_TTL=300

# NLP
SPACY_MODEL=fr_core_news_sm

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
PROMETHEUS_MULTIPROC_DIR=/tmp