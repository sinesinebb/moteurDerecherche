from django.urls import path
from . import views

urlpatterns = [
    # Authentication
    path('auth/login/', views.login, name='login'),
    path('auth/register/', views.register, name='register'),
    path('auth/logout/', views.logout, name='logout'),
    path('auth/refresh/', views.refresh_token, name='refresh_token'),
    path('auth/change-password/', views.change_password, name='change_password'),
    path('auth/profile/', views.profile, name='profile'),
    
    # User profile
    path('users/profile/', views.profile, name='profile'),
    path('users/preferences/', views.user_preferences, name='user_preferences'),
        # Nouvelles routes
    path('user/preferences/', views.user_preferences, name='user_preferences'),
    path('user/history/', views.user_history, name='user_history'),
    path('user/history/list/', views.get_user_history, name='get_user_history'),
    # Nouvelles routes pour les préférences et historique
    path('preferences/', views.update_user_preferences, name='update_preferences'),
    path('history/add/', views.add_to_search_history, name='add_history'),
    path('history/', views.get_search_history, name='get_history'),
    path('history/clear/', views.clear_search_history, name='clear_history'),
    path('password/update/', views.update_password, name='update_password'),
    
    # Route pour les préférences (version alternative)
    # path('user-preferences/', views.user_preferences, name='user_preferences'),
]
